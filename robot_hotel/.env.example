# Copier en .env et adapter
# cp .env.example .env

# Robot Pepper
PEPPER_IP=192.168.13.213
PEPPER_PORT=9559
PEPPER_LANGUAGE=French

# API Flask (pour le client Pepper)
FLASK_API_URL=http://localhost:5000

# Redis (pour Flask)
REDIS_HOST=redis
REDIS_PORT=6379

# Message vocal (mic en bas) : envoi audio, réponse texte (true/false)
ENABLE_VOICE_CALL=true
# Appel vocal (icône téléphone) : vous parlez, réponse de Pepper en audio sur votre appareil (true/false)
ENABLE_REALTIME_VOICE_CALL=false
# Mode "vrai appel" : un appui micro = parler, 3 s silence = envoi auto, interrompre Pepper en parlant (true/false)
REALTIME_CALL_VOICE_MODE=false
# Afficher le bouton « Appel » sur la tablette du robot (true/false)
SHOW_TABLET_CALL_BUTTON=true
