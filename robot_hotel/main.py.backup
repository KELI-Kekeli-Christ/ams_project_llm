# --- ROUTES DE VALIDATION ET CONFIRMATION DE RÉSERVATION ---

@app.route('/validate')
def validate_reservation():
    """
    Page de validation de réservation
    ---
    parameters:
      - name: session_id
        in: query
        type: string
        required: true
        description: ID de la session de réservation
      - name: action
        in: query
        type: string
        required: false
        description: Action à effectuer (validate_reservation)
    """
    from services.chat import get_reservation_session

    session_id = request.args.get('session_id')
    action = request.args.get('action')

    if not session_id:
        return render_template('error.html', message="Session ID manquant"), 400

    user_data, current_step = get_reservation_session(session_id)

    if not user_data or current_step != 'complete':
        return render_template('error.html', message="Session de réservation invalide ou expirée"), 400

    return render_template('validation.html', session_id=session_id, user_data=user_data)


@app.route('/get_reservation_session')
def get_reservation_session_endpoint():
    """
    Récupère les données de session de réservation
    ---
    parameters:
      - name: session_id
        in: query
        type: string
        required: true
        description: ID de la session de réservation
    """
    from services.chat import get_reservation_session

    session_id = request.args.get('session_id')
    if not session_id:
        return jsonify({"error": "Session ID manquant"}), 400

    user_data, current_step = get_reservation_session(session_id)

    if not user_data:
        return jsonify({"error": "Session non trouvée"}), 404

    return jsonify({
        "session_id": session_id,
        "user_data": user_data,
        "current_step": current_step
    })


@app.route('/confirm_reservation', methods=['POST'])
def confirm_reservation():
    """
    Confirme et finalise la réservation
    ---
    parameters:
      - name: session_id
        in: body
        type: string
        required: true
        description: ID de la session de réservation
      - name: send_email
        in: body
        type: boolean
        required: false
        description: Envoyer la confirmation par email
    """
    from services.chat import get_reservation_session, delete_reservation_session
    from services.make_reservation import make_reservation
    from services.email import send_reservation_confirmation

    data = request.get_json()
    session_id = data.get('session_id')
    send_email = data.get('send_email', False)

    if not session_id:
        return jsonify({"error": "Session ID manquant"}), 400

    user_data, current_step = get_reservation_session(session_id)

    if not user_data or current_step != 'complete':
        return jsonify({"error": "Session de réservation invalide"}), 400

    try:
        # Créer la réservation dans la base de données
        reservation_result = make_reservation(user_data)

        if reservation_result.get('success'):
            # Envoyer les emails de confirmation
            if send_email and user_data.get('email'):
                email_result = send_reservation_confirmation(user_data)
                if not email_result.get('success'):
                    print(f"⚠️ Échec envoi email: {email_result.get('error')}")

            # Supprimer la session temporaire
            delete_reservation_session(session_id)

            return jsonify({
                "success": True,
                "message": "Réservation confirmée avec succès !",
                "reservation_id": reservation_result.get('reservation_id')
            })
        else:
            return jsonify({"error": "Échec de la création de la réservation"}), 500

    except Exception as e:
        print(f"Erreur confirmation réservation: {e}")
        return jsonify({"error": "Erreur interne du serveur"}), 500


@app.route('/reservation_success')
def reservation_success():
    """
    Page de succès après confirmation de réservation
    ---
    parameters:
      - name: reservation_id
        in: query
        type: string
        required: false
        description: ID de la réservation créée
    """
    reservation_id = request.args.get('reservation_id')
    return render_template('success.html', reservation_id=reservation_id)


@app.route('/chat')
def chat_page():
    """
    Page de chat pour les réservations
    """
    return render_template('chat.html')


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
